---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="container-x py-28 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-extrabold">This page failed its test.</h1>
    <p class="mt-4 text-ink-600 dark:text-ink-300">The page you are looking for doesn't exist or has moved.</p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</Base>
