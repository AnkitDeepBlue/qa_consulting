---
import { innovations } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section relative overflow-hidden bg-ink-950 text-white">
  <div class="pointer-events-none absolute -left-32 top-0 h-96 w-96 rounded-full bg-accent-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-24 bottom-0 h-96 w-96 rounded-full bg-sky-500/15 blur-3xl"></div>
  <div class="container-x relative">
    <p class="eyebrow !text-accent-400">Innovation</p>
    <h2 class="mt-3 text-3xl font-extrabold !text-white sm:text-4xl lg:whitespace-nowrap">Building the tools and ideas adopted worldwide</h2>
    <p class="mt-4 max-w-2xl text-ink-200">Beyond client work, I contribute to the QA community through open-source software and published research.</p>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.35fr_1fr]">
      {
        innovations.map((item, i) => (
          <article class="relative flex flex-col rounded-3xl border border-white/10 bg-white/[0.04] p-7 backdrop-blur sm:p-9">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-500/15 text-accent-400">
                <Icon d={i === 0 ? 'M8 9l-4 3 4 3 M16 9l4 3-4 3 M13 6l-2 12' : 'M6 3h9l4 4v14H6z M14 3v5h5 M9 13h7 M9 17h5'} />
              </span>
              <span class="rounded-full border border-accent-400/30 bg-accent-400/10 px-3 py-1 text-xs font-semibold text-accent-300">{item.kind}</span>
            </div>
            <h3 class={`mt-6 font-extrabold !text-white ${i === 0 ? 'font-mono text-2xl sm:text-3xl' : 'text-2xl sm:text-3xl'}`}>{item.title}</h3>
            <p class="mt-4 text-ink-200">{item.text}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {item.tags.map((t) => <li class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-ink-100">{t}</li>)}
            </ul>
            {item.code && (
              <div class="mt-6 overflow-x-auto rounded-xl border border-white/10 bg-black/40 px-4 py-3 font-mono text-sm text-accent-300">
                <span class="select-none text-ink-400">$ </span>{item.code}
              </div>
            )}
            {item.link && (
              <a href={item.link.href} target="_blank" rel="noopener" class="btn-primary mt-6 self-start">{item.link.label} ↗</a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
