---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Share from '../../components/Share.astro';

const enquire = `/contact?service=${encodeURIComponent('QA Zero to Hero Bootcamp')}`;

const audiences = [
  {
    title: 'New to QA',
    text: 'Fresh graduates and career switchers who want a structured, practical path into software testing.',
    icon: 'M12 3l2.5 5 5.5.8-4 3.9 1 5.5L12 15.6 7 18.2l1-5.5-4-3.9 5.5-.8z',
  },
  {
    title: 'Returning after a career gap',
    text: 'Get back up to speed with modern tools, AI in testing and what interviews ask for today.',
    icon: 'M4 12a8 8 0 1014.9-4 M19 3v5h-5',
  },
  {
    title: 'Struggling to land a QA job',
    text: 'Close the skill gaps, build a portfolio that stands out and walk into interviews prepared.',
    icon: 'M4 19h16 M5 15l4-4 3 3 6-7 M15 7h3v3',
  },
];

const phases = [
  {
    name: 'SQA Concepts',
    text: 'Think like a professional tester before touching any tool.',
    points: ['SDLC, STLC and Agile/Scrum', 'Test design techniques: boundary values, equivalence, exploratory', 'Writing test cases and clear bug reports', 'JIRA, test management and SQL basics', 'ISTQB-aligned fundamentals'],
  },
  {
    name: 'Automation',
    text: 'Learn to code, automate and design frameworks: the SQA to SDET jump.',
    points: ['Python up to object-oriented programming', 'UI automation with Selenium and Playwright', 'Page Object Model, pytest and BDD', 'API testing: Postman to Python requests', 'Git, GitHub and CI/CD with GitHub Actions'],
  },
  {
    name: 'AI Testing',
    text: 'Add the skills employers are hiring for now.',
    points: ['AI-assisted test generation', 'Self-healing tests and agentic workflows', 'MCP with Playwright and AI assistants', 'Testing AI/ML features'],
  },
  {
    name: 'Live Project',
    text: 'Apply everything end to end on a real-world application, the way you would on the job.',
    points: ['Test strategy and test cases for a real application', 'Build your own automation framework from scratch', 'UI + API suites running in CI/CD', 'AI-assisted testing in the workflow', 'Published on your GitHub as your portfolio'],
  },
  {
    name: 'Job Readiness',
    text: 'Turn your new skills into offers.',
    points: ['Resume and LinkedIn makeover', 'Mock interviews with detailed feedback', 'Interview question bank and prep notes', 'Job search strategy'],
  },
];

const format = [
  { title: '1:1 live coaching', text: 'Personal sessions with me, never a crowded batch.' },
  { title: 'Personalised plan', text: 'We start from where you are today and skip what you already know.' },
  { title: 'Hands-on assignments', text: 'Real exercises with code reviews and feedback.' },
  { title: 'Material included', text: 'Notes, exercises, question bank and checklists.' },
];
---

<Base
  title="QA Zero to Hero Bootcamp (1:1 coaching)"
  description="1:1 QA coaching: SQA Concepts to Automation to AI Testing to Live Project. For freshers, professionals returning after a career gap and QA engineers struggling to land a job."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-ink-100 dark:border-ink-800">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(45,212,191,0.15),transparent_55%)]"></div>
    <div class="container-x relative py-12 sm:py-16">
      <a href="/courses" class="text-sm font-semibold text-accent-700 dark:text-accent-400">← All courses</a>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-gradient-to-r from-accent-500 to-sky-500 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">1:1 Coaching</span>
        <span class="chip">Enrolling now</span>
        <span class="chip">Material included</span>
      </div>
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold sm:text-5xl">QA Zero to Hero Bootcamp</h1>
      <p class="mt-3 text-lg font-semibold text-accent-700 dark:text-accent-400">SQA Concepts to Automation to AI Testing to Live Project</p>
      <p class="mt-4 max-w-2xl text-lg text-ink-600 dark:text-ink-300">
        A personal, end-to-end coaching program that takes you from testing fundamentals to automation frameworks and AI
        testing, then gets you interview-ready. Built from 12+ years of leading and hiring QA teams.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={enquire} class="btn-primary">Book a free discovery call</a>
        <a href="#curriculum" class="btn-ghost">See the curriculum</a>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Who it's for</p>
      <h2 class="mt-3 text-3xl font-extrabold">Built for where you are right now</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          audiences.map((a) => (
            <div class="card">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-500/10 text-accent-700 dark:text-accent-400">
                <Icon d={a.icon} />
              </span>
              <h3 class="mt-5 text-lg font-bold">{a.title}</h3>
              <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">{a.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Curriculum -->
  <section id="curriculum" class="section scroll-mt-20 bg-ink-50 dark:bg-ink-900">
    <div class="container-x">
      <p class="eyebrow">Curriculum</p>
      <h2 class="mt-3 text-3xl font-extrabold">Five phases, zero to hero</h2>
      <p class="mt-3 max-w-2xl text-ink-600 dark:text-ink-300">Each phase builds on the last. Your pace and depth are tailored to your starting point and goals.</p>
      <ol class="mt-10 space-y-5">
        {
          phases.map((p, i) => (
            <li class="card relative overflow-hidden sm:!p-8">
              <span class="absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-accent-500 to-sky-500" />
              <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr]">
                <div class="flex items-start gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-500/10 font-display text-lg font-extrabold text-accent-700 dark:text-accent-400">
                    {i + 1}
                  </span>
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">Phase {i + 1}</p>
                    <h3 class="text-xl font-extrabold">{p.name}</h3>
                    <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">{p.text}</p>
                  </div>
                </div>
                <ul class="grid gap-2 sm:grid-cols-2">
                  {p.points.map((pt) => (
                    <li class="flex gap-2 text-sm text-ink-700 dark:text-ink-200">
                      <Icon d="M5 13l4 4L19 7" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600 dark:text-accent-400" />
                      {pt}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Format & outcomes -->
  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="mt-3 text-3xl font-extrabold">Coaching, not just content</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            format.map((f) => (
              <div class="rounded-2xl border border-ink-100 p-5 dark:border-ink-800">
                <h3 class="font-bold">{f.title}</h3>
                <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{f.text}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <p class="eyebrow">What you walk away with</p>
        <h2 class="mt-3 text-3xl font-extrabold">Job-ready, with proof</h2>
        <ul class="mt-8 space-y-4">
          {
            [
              'Solid SQA fundamentals and test design skills',
              'Hands-on UI and API automation in Python',
              'A live project and your own framework on GitHub to show employers',
              'Practical AI testing skills most candidates lack',
              'A polished resume, LinkedIn profile and interview confidence',
            ].map((o) => (
              <li class="flex gap-3 text-ink-700 dark:text-ink-200">
                <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent-500 text-white">
                  <Icon d="M5 13l4 4L19 7" class="h-3 w-3" />
                </span>
                {o}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section !pt-0">
    <div class="container-x">
      <div class="relative overflow-hidden rounded-3xl bg-ink-900 px-6 py-14 text-center sm:px-12 dark:bg-ink-800">
        <div class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-accent-500/20 blur-3xl"></div>
        <h2 class="relative mx-auto max-w-2xl text-3xl font-extrabold !text-white sm:text-4xl">Ready to start your QA journey?</h2>
        <p class="relative mx-auto mt-4 max-w-xl text-ink-200">
          Book a free discovery call. We'll look at your background and goals, and map out your personal path from zero to hero.
        </p>
        <div class="relative mt-8 flex flex-wrap justify-center gap-3">
          <a href={enquire} class="btn-primary">Book a free discovery call</a>
          <a href="/courses/qa-roadmap-2026" class="btn border border-white/20 text-white hover:bg-white/10">Read the free QA Roadmap</a>
        </div>
      </div>
      <div class="mx-auto max-w-3xl">
        <Share title="QA Zero to Hero Bootcamp: SQA Concepts to Automation to AI Testing to Live Project" />
      </div>
    </div>
  </section>
</Base>
