rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Moderator: can delete any comment. Keep in sync with adminEmails in src/data/firebase.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ankit.deepblue@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photo', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /posts/{postId}/likes/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Email leads from gated downloads. Write-only for visitors; only the admin can read.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'newsletter', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 50
        && request.resource.data.newsletter is bool
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Everything else is closed by default.
  }
}
