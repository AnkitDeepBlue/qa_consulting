---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  source?: string;
}
const { href, title, description, date, tags = [], source } = Astro.props;
const fmt = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<article class="card group flex flex-col hover:-translate-y-0.5 hover:shadow-md">
  <div class="flex items-center gap-2 text-xs text-ink-500 dark:text-ink-400">
    <time datetime={date.toISOString()}>{fmt}</time>
    {source && <><span aria-hidden="true">·</span><span>via {source}</span></>}
  </div>
  <h3 class="mt-2 text-lg font-bold leading-snug">
    <a href={href} class="after:absolute after:inset-0 group-hover:text-accent-700 dark:group-hover:text-accent-400">{title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm text-ink-600 dark:text-ink-300">{description}</p>
  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((t) => <span class="chip">{t}</span>)}
    </div>
  )}
</article>

<style>
  article { position: relative; }
</style>
