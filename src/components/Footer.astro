---
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-100 bg-ink-50 dark:border-ink-800 dark:bg-ink-900">
  <div class="container-x grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-bold text-ink-900 dark:text-white">{site.brand}</p>
      <p class="mt-2 max-w-xs text-sm text-ink-600 dark:text-ink-300">
        Helping startups and established teams build quality that scales, from first test strategy to AI-driven automation.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink-900 dark:text-white">Explore</p>
      <ul class="mt-3 grid grid-cols-2 gap-2 text-sm">
        {nav.map((i) => <li><a class="text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-400" href={i.href}>{i.label}</a></li>)}
        <li><a class="text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-400" href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-ink-900 dark:text-white">Get in touch</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-400" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-400" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
        <li class="flex gap-4">
          <a class="text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-400" href="/blog/rss.xml">Blog RSS</a>
          <a class="text-ink-600 hover:text-accent-700 dark:text-ink-300 dark:hover:text-accent-400" href="/news/rss.xml">News RSS</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-100 py-5 text-center text-xs text-ink-500 dark:border-ink-800 dark:text-ink-400">
    © {year} {site.brand}. All rights reserved.
  </div>
</footer>
