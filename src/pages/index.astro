---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import CTA from '../components/CTA.astro';
import CompanyStrip from '../components/CompanyStrip.astro';
import Innovation from '../components/Innovation.astro';
import Expertise from '../components/Expertise.astro';
import ServiceCard from '../components/ServiceCard.astro';
import photo from '../assets/ankit.webp';
import { stats, services, process } from '../data/site';

const byDate = (a: { data: { pubDate: Date } }, b: { data: { pubDate: Date } }) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate).slice(0, 3);
const news = (await getCollection('news', ({ data }) => !data.draft)).sort(byDate).slice(0, 3);
const forOrgs = services.filter((s) => s.audience === 'organizations');
const forPros = services.filter((s) => s.audience === 'professionals');
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(45,212,191,0.15),transparent_55%)]"></div>
    <div class="container-x relative grid items-center gap-12 pb-16 pt-8 sm:pb-20 sm:pt-12 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-accent-500/30 bg-accent-500/10 py-1.5 pl-3 pr-1.5 text-sm font-semibold shadow-sm shadow-accent-500/10">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-60"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent-500"></span>
          </span>
          <span class="text-ink-800 dark:text-ink-100">QA &amp; Test Automation Consulting</span>
          <span class="rounded-full bg-gradient-to-r from-accent-500 to-sky-500 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-white">AI-Driven</span>
        </div>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.1] sm:text-5xl lg:text-6xl">
          Software built right, <span class="text-accent-600 dark:text-accent-400">shipped fast</span>, trusted in production.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-600 dark:text-ink-300">
          I'm <strong class="text-ink-900 dark:text-white">Ankit Tripathi</strong>, an independent
          <strong class="text-ink-900 dark:text-white">QA Consultant</strong> with 12+ years as a Senior Lead SDET, Test Architect
          and QA Manager at global MNCs. I help startups and enterprises build QA from scratch or rebuild it, combining solid
          test strategy and process with <strong class="text-ink-900 dark:text-white">AI-driven automation</strong> that scales.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary">Book a free discovery call</a>
          <a href="/services" class="btn-ghost">Explore services</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-2">
          {['ISTQB®', 'SAFe® POPM', 'PCAP™ Python', 'AI Developer', 'Agentic AI'].map((c) => <li class="chip">{c}</li>)}
        </ul>
      </div>
      <div class="relative mx-auto w-full max-w-sm">
        <div class="absolute -inset-3 rotate-3 rounded-[2rem] bg-gradient-to-br from-accent-400/40 to-ink-300/30 dark:from-accent-500/30 dark:to-ink-700/40"></div>
        <Image
          src={photo}
          alt="Ankit Tripathi, QA consultant"
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 384px, 80vw"
          loading="eager"
          class="relative aspect-square w-full rounded-[1.75rem] object-cover shadow-xl"
        />
        <div class="card absolute -bottom-6 -left-4 flex items-center gap-3 !p-4 sm:-left-10">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-500/15 text-accent-700 dark:text-accent-400">
            <Icon d="M5 13l4 4L19 7" class="h-5 w-5" />
          </span>
          <span class="text-sm">
            <span class="block font-semibold text-ink-900 dark:text-white">Open to consulting</span>
            <span class="text-ink-500 dark:text-ink-400">Remote · Worldwide</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <CompanyStrip />

  <!-- Stats -->
  <section class="bg-ink-50 dark:bg-ink-900">
    <div class="container-x grid grid-cols-2 gap-8 py-10 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div>
            <p class="font-display text-3xl font-extrabold text-ink-900 sm:text-4xl dark:text-white">{s.value}</p>
            <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">How I can help</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Consulting services</h2>
          <p class="mt-3 max-w-2xl text-ink-600 dark:text-ink-300">
            For organizations building or scaling QA, and for QA professionals growing their careers.
          </p>
        </div>
        <a href="/services" class="btn-ghost">All services →</a>
      </div>

      <h3 class="mt-12 flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-ink-500 dark:text-ink-400">
        <Icon d="M4 21V5l8-3 8 3v16 M9 21v-4h6v4 M8 8h.01 M12 8h.01 M16 8h.01 M8 12h.01 M12 12h.01 M16 12h.01" class="h-4 w-4" />For organizations
      </h3>
      <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {forOrgs.map((s) => <ServiceCard service={s} />)}
      </div>

      <h3 class="mt-14 flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-ink-500 dark:text-ink-400">
        <Icon d="M12 4a4 4 0 110 8 4 4 0 010-8z M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6" class="h-4 w-4" />For QA professionals
      </h3>
      <div class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {forPros.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <Innovation />

  <Expertise />

  <!-- Process -->
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">How we work together</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">A clear, low-risk engagement</h2>
      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((p) => (
            <li class="border-t-2 border-accent-500/40 pt-6">
              <span class="font-display text-sm font-bold text-accent-700 dark:text-accent-400">{p.step}</span>
              <h3 class="mt-2 text-lg font-bold">{p.title}</h3>
              <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Latest content -->
  {
    (posts.length > 0 || news.length > 0) && (
      <section class="section border-t border-ink-100 dark:border-ink-800">
        <div class="container-x grid gap-14">
          {posts.length > 0 && (
            <div>
              <div class="flex items-end justify-between gap-4">
                <h2 class="text-2xl font-extrabold sm:text-3xl">From the blog</h2>
                <a href="/blog" class="text-sm font-semibold text-accent-700 dark:text-accent-400">All posts →</a>
              </div>
              <div class="mt-6 grid gap-6 md:grid-cols-3">
                {posts.map((p) => (
                  <PostCard href={`/blog/${p.id}`} title={p.data.title} description={p.data.description} date={p.data.pubDate} tags={p.data.tags} />
                ))}
              </div>
            </div>
          )}
          {news.length > 0 && (
            <div>
              <div class="flex items-end justify-between gap-4">
                <h2 class="text-2xl font-extrabold sm:text-3xl">QA news</h2>
                <a href="/news" class="text-sm font-semibold text-accent-700 dark:text-accent-400">All news →</a>
              </div>
              <div class="mt-6 grid gap-6 md:grid-cols-3">
                {news.map((p) => (
                  <PostCard href={`/news/${p.id}`} title={p.data.title} description={p.data.description} date={p.data.pubDate} source={p.data.sourceName} tags={p.data.tags} />
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <CTA />
</Base>
