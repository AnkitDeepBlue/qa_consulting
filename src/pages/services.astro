---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { services, process, problems } from '../data/site';

const groups = [
  {
    eyebrow: 'For organizations',
    title: 'Tailored QA solutions for your team',
    intro: "Whether you're a startup setting up QA for the first time or an enterprise improving what you have, every engagement is shaped around your specific challenge.",
    items: services.filter((s) => s.audience === 'organizations'),
  },
  {
    eyebrow: 'For QA professionals',
    title: 'Grow your QA career',
    intro: 'Interview prep, 1:1 mentoring and courses for testers moving into automation, SDET and lead roles.',
    items: services.filter((s) => s.audience === 'professionals'),
  },
];

const engagements = [
  { name: 'QA Health Check', length: '1–2 weeks', text: 'A focused audit with findings and a prioritized roadmap. The fastest way to know where you stand.' },
  { name: 'Project Engagement', length: '1–3 months', text: 'Hands-on delivery of a defined scope: a new framework, CI/CD quality gates or a full QA setup.' },
  { name: 'Fractional QA Lead', length: 'Ongoing, part-time', text: 'Senior QA leadership a few days a month: strategy, reviews, hiring and team coaching.' },
];
---

<Base title="Services" description="QA consulting services: QA setup from scratch, QA audits, test automation frameworks, AI-driven testing, CI/CD quality gates, team training, mock interviews and career mentoring.">
  <PageHeader
    eyebrow="Services"
    title="Tell me the problem. I'll build the solution."
    intro="Every product and team faces different quality challenges. I start by listening to yours, find the root cause, then design and implement a solution tailored to your team, tools and goals. For QA professionals, I offer focused coaching, interview prep and mentoring."
  />

  <section class="section !pb-0">
    <div class="container-x">
      <p class="eyebrow">Sound familiar?</p>
      <h2 class="mt-3 text-3xl font-extrabold">Problems I solve</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          problems.map((p) => (
            <a href={`#${p.slug}`} class="card group grid gap-3 hover:-translate-y-0.5 hover:border-accent-300 hover:shadow-md">
              <p class="font-semibold text-ink-900 dark:text-white">“{p.problem}”</p>
              <p class="flex gap-2 text-sm text-ink-600 dark:text-ink-300">
                <span class="font-bold text-accent-700 dark:text-accent-400">→</span>
                {p.solution}
              </p>
            </a>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-ink-600 dark:text-ink-300">
        Facing something else? <a href="/contact" class="font-semibold text-accent-700 hover:underline dark:text-accent-400">Tell me about it</a>. Most engagements start with a problem that doesn't fit a template.
      </p>
    </div>
  </section>

  {
    groups.map((g, gi) => (
      <section class:list={['section', gi < groups.length - 1 && '!pb-0']}>
        <div class="container-x">
          <p class="eyebrow">{g.eyebrow}</p>
          <h2 class="mt-3 text-3xl font-extrabold">{g.title}</h2>
          <p class="mt-3 max-w-2xl text-ink-600 dark:text-ink-300">{g.intro}</p>
          <div class="mt-10 space-y-6">
            {g.items.map((s, i) => (
              <article id={s.slug} class="card scroll-mt-24 grid gap-8 lg:grid-cols-[1fr_1fr] lg:p-10">
                <div>
                  <div class="flex items-center gap-3">
                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-500/10 text-accent-700 dark:text-accent-400">
                      <Icon d={s.icon} />
                    </span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-ink-400">0{i + 1}</span>
                  </div>
                  <h3 class="mt-5 text-2xl font-extrabold">{s.title}</h3>
                  <p class="mt-1 text-sm font-medium text-accent-700 dark:text-accent-400">Best for: {s.forWho}</p>
                  <p class="mt-4 text-ink-600 dark:text-ink-300">{s.summary}</p>
                  <a href={s.href ?? `/contact?service=${encodeURIComponent(s.title)}`} class="btn-ghost mt-6">
                    {s.href === '/courses' ? 'Browse courses →' : s.href ? 'View details →' : 'Enquire about this →'}
                  </a>
                </div>
                <div class="rounded-xl bg-ink-50 p-6 dark:bg-ink-950/60">
                  <p class="text-sm font-semibold text-ink-900 dark:text-white">What you get</p>
                  <ul class="mt-4 space-y-3">
                    {s.deliverables.map((d) => (
                      <li class="flex gap-3 text-sm text-ink-700 dark:text-ink-200">
                        <Icon d="M5 13l4 4L19 7" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600 dark:text-accent-400" />
                        {d}
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section border-t border-ink-100 bg-ink-50 dark:border-ink-800 dark:bg-ink-900">
    <div class="container-x">
      <p class="eyebrow">Ways to engage (organizations)</p>
      <h2 class="mt-3 text-3xl font-extrabold">Pick the model that fits</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          engagements.map((e) => (
            <div class="card">
              <p class="text-xs font-semibold uppercase tracking-wider text-accent-700 dark:text-accent-400">{e.length}</p>
              <h3 class="mt-2 text-xl font-bold">{e.name}</h3>
              <p class="mt-3 text-sm text-ink-600 dark:text-ink-300">{e.text}</p>
            </div>
          ))
        }
      </div>
      <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((p) => (
            <li class="border-t border-ink-200 pt-5 dark:border-ink-700">
              <span class="font-display text-sm font-bold text-accent-700 dark:text-accent-400">{p.step}</span>
              <h3 class="mt-1 font-bold">{p.title}</h3>
              <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTA />
</Base>
