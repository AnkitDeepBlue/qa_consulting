---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import CTA from '../components/CTA.astro';
import photo from '../assets/ankit.webp';
import { site, stats, services, process, domains } from '../data/site';

const byDate = (a: { data: { pubDate: Date } }, b: { data: { pubDate: Date } }) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate).slice(0, 3);
const news = (await getCollection('news', ({ data }) => !data.draft)).sort(byDate).slice(0, 3);
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(45,212,191,0.15),transparent_55%)]"></div>
    <div class="container-x relative grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="eyebrow">{site.tagline}</p>
        <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] sm:text-5xl lg:text-6xl">
          Software built right, <span class="text-accent-600 dark:text-accent-400">shipped fast</span>, trusted in production.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-600 dark:text-ink-300">
          I'm Ankit Tripathi, a Test Architect with 12+ years in Quality Engineering. Whether you are building QA from scratch
          or rebuilding it, I turn testing into a scalable quality engine, powered by solid process and AI-driven automation.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary">Book a free discovery call</a>
          <a href="/services" class="btn-ghost">Explore services</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-2">
          {['ISTQB®', 'SAFe® POPM', 'PCAP™ Python', 'Agentic AI'].map((c) => <li class="chip">{c}</li>)}
        </ul>
      </div>
      <div class="relative mx-auto w-full max-w-sm">
        <div class="absolute -inset-3 rotate-3 rounded-[2rem] bg-gradient-to-br from-accent-400/40 to-ink-300/30 dark:from-accent-500/30 dark:to-ink-700/40"></div>
        <Image
          src={photo}
          alt="Ankit Tripathi, QA consultant"
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 384px, 80vw"
          loading="eager"
          class="relative aspect-square w-full rounded-[1.75rem] object-cover shadow-xl"
        />
        <div class="card absolute -bottom-6 -left-4 flex items-center gap-3 !p-4 sm:-left-10">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-500/15 text-accent-700 dark:text-accent-400">
            <Icon d="M5 13l4 4L19 7" class="h-5 w-5" />
          </span>
          <span class="text-sm">
            <span class="block font-semibold text-ink-900 dark:text-white">Open to consulting</span>
            <span class="text-ink-500 dark:text-ink-400">Remote · Worldwide</span>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-ink-100 bg-ink-50 dark:border-ink-800 dark:bg-ink-900">
    <div class="container-x grid grid-cols-2 gap-8 py-10 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div>
            <p class="font-display text-3xl font-extrabold text-ink-900 sm:text-4xl dark:text-white">{s.value}</p>
            <p class="mt-1 text-sm text-ink-600 dark:text-ink-300">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">How I can help</p>
          <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Consulting services</h2>
          <p class="mt-3 max-w-2xl text-ink-600 dark:text-ink-300">
            For startups building their first QA function and established organizations that need to rebuild or scale it.
          </p>
        </div>
        <a href="/services" class="btn-ghost">All services →</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <a href={`/services#${s.slug}`} class="card group hover:-translate-y-0.5 hover:border-accent-300 hover:shadow-md">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-500/10 text-accent-700 dark:text-accent-400">
                <Icon d={s.icon} />
              </span>
              <h3 class="mt-5 text-lg font-bold group-hover:text-accent-700 dark:group-hover:text-accent-400">{s.title}</h3>
              <p class="mt-2 text-sm text-ink-600 dark:text-ink-300">{s.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section bg-ink-900 text-white dark:bg-ink-900">
    <div class="container-x">
      <p class="eyebrow !text-accent-400">How we work together</p>
      <h2 class="mt-3 text-3xl font-extrabold !text-white sm:text-4xl">A clear, low-risk engagement</h2>
      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((p) => (
            <li class="border-t border-white/15 pt-6">
              <span class="font-display text-sm font-bold text-accent-400">{p.step}</span>
              <h3 class="mt-2 text-lg font-bold !text-white">{p.title}</h3>
              <p class="mt-2 text-sm text-ink-200">{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Credibility -->
  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Proof, not promises</p>
        <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Built in the open</h2>
        <p class="mt-4 text-ink-600 dark:text-ink-300">
          I created <strong class="text-ink-900 dark:text-white">selenium-python-ai-agent</strong>, an open-source multi-agent LLM
          framework on PyPI that plans, generates and self-heals Selenium Python test suites. I also published the peer-reviewed
          white paper <em>Reverse Build Testing</em> in Quest Journals.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={site.pypi} target="_blank" rel="noopener" class="btn-ghost">View on PyPI ↗</a>
          <a href="/about" class="btn-ghost">Full background →</a>
        </div>
      </div>
      <div class="card">
        <p class="text-sm font-semibold text-ink-900 dark:text-white">Industries I've delivered quality for</p>
        <ul class="mt-4 flex flex-wrap gap-2">{domains.map((d) => <li class="chip">{d}</li>)}</ul>
        <p class="mt-6 text-sm font-semibold text-ink-900 dark:text-white">Core stack</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {['Python', 'Playwright', 'Selenium', 'Robot Framework', 'Pytest-BDD', 'REST APIs', 'Jenkins', 'GitHub Actions', 'LLMs / MCP'].map((d) => <li class="chip">{d}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Latest content -->
  {
    (posts.length > 0 || news.length > 0) && (
      <section class="section border-t border-ink-100 dark:border-ink-800">
        <div class="container-x grid gap-14">
          {posts.length > 0 && (
            <div>
              <div class="flex items-end justify-between gap-4">
                <h2 class="text-2xl font-extrabold sm:text-3xl">From the blog</h2>
                <a href="/blog" class="text-sm font-semibold text-accent-700 dark:text-accent-400">All posts →</a>
              </div>
              <div class="mt-6 grid gap-6 md:grid-cols-3">
                {posts.map((p) => (
                  <PostCard href={`/blog/${p.id}`} title={p.data.title} description={p.data.description} date={p.data.pubDate} tags={p.data.tags} />
                ))}
              </div>
            </div>
          )}
          {news.length > 0 && (
            <div>
              <div class="flex items-end justify-between gap-4">
                <h2 class="text-2xl font-extrabold sm:text-3xl">QA news</h2>
                <a href="/news" class="text-sm font-semibold text-accent-700 dark:text-accent-400">All news →</a>
              </div>
              <div class="mt-6 grid gap-6 md:grid-cols-3">
                {news.map((p) => (
                  <PostCard href={`/news/${p.id}`} title={p.data.title} description={p.data.description} date={p.data.pubDate} source={p.data.sourceName} tags={p.data.tags} />
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <CTA />
</Base>
