---
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-ink-100/80 bg-white/85 backdrop-blur dark:border-ink-800 dark:bg-ink-950/85">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.brand} home`}>
      <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8" />
      <span class="leading-tight">
        <span class="block font-display text-[15px] font-bold text-ink-900 dark:text-white">{site.shortBrand}</span>
        <span class="block text-[11px] font-medium uppercase tracking-wider text-ink-500 dark:text-ink-300">QA Consulting</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition',
              isActive(item.href)
                ? 'text-accent-700 dark:text-accent-400'
                : 'text-ink-600 hover:text-ink-900 dark:text-ink-300 dark:hover:text-white',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md p-2 text-ink-600 hover:bg-ink-50 dark:text-ink-300 dark:hover:bg-ink-800"
        aria-label="Toggle dark mode"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" /></svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <a href="/contact" class="btn-primary hidden sm:inline-flex">Book a call</a>
      <button
        id="menu-toggle"
        type="button"
        class="rounded-md p-2 text-ink-700 hover:bg-ink-50 lg:hidden dark:text-ink-200 dark:hover:bg-ink-800"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-ink-100 lg:hidden dark:border-ink-800" aria-label="Mobile">
    <div class="container-x flex flex-col py-3">
      {
        [...nav, { href: '/contact', label: 'Contact' }].map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-3 py-2.5 text-base font-medium',
              isActive(item.href) ? 'text-accent-700 dark:text-accent-400' : 'text-ink-700 dark:text-ink-200',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
