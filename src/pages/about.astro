---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import CompanyStrip from '../components/CompanyStrip.astro';
import Innovation from '../components/Innovation.astro';
import Expertise from '../components/Expertise.astro';
import Credentials from '../components/Credentials.astro';
import photo from '../assets/ankit.webp';
import { site, highlights, experience, awards, education, domains, certifications } from '../data/site';

const facts = [
  { value: '12+', label: 'Years in QA' },
  { value: '100+', label: 'QA engineers led' },
  { value: `${domains.length}+`, label: 'Industries' },
  { value: `${certifications.length}+`, label: 'Certifications' },
];
---

<Base
  title="About"
  description="Portfolio of Ankit Tripathi: QA Consultant, Senior Lead SDET, Test Architect and QA Manager with 12+ years at global MNCs, creator of selenium-python-ai-agent and author of the Reverse Build Testing white paper."
>
  <!-- Portfolio hero -->
  <section class="relative overflow-hidden border-b border-ink-100 dark:border-ink-800">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(45,212,191,0.14),transparent_55%)]"></div>
    <div class="container-x relative grid items-center gap-12 pb-16 pt-10 sm:pb-20 sm:pt-14 lg:grid-cols-[1fr_1.35fr]">
      <div class="relative mx-auto w-full max-w-sm lg:order-none">
        <div class="absolute -inset-3 -rotate-3 rounded-[2rem] bg-gradient-to-br from-accent-400/40 to-sky-400/20 dark:from-accent-500/30 dark:to-sky-500/10"></div>
        <Image
          src={photo}
          alt="Portrait of Ankit Tripathi"
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 384px, 80vw"
          loading="eager"
          class="relative aspect-square w-full rounded-[1.75rem] object-cover shadow-xl"
        />
      </div>
      <div>
        <p class="eyebrow">Portfolio</p>
        <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Ankit Tripathi</h1>
        <p class="mt-3 text-lg font-semibold text-accent-700 dark:text-accent-400">
          QA Consultant · Test Architect · Senior Lead SDET · QA Manager
        </p>
        <div class="mt-6 space-y-4 text-lg text-ink-600 dark:text-ink-300">
          <p>
            Over 12+ years at global MNCs, I have grown from a hands-on QA engineer to Test Architect, Senior Lead SDET and
            QA Manager, leading 100+ QA engineers, building automation frameworks from scratch and bringing agentic
            AI into everyday testing.
          </p>
          <p>
            I also work with startups and established organizations to solve their specific QA challenges, from setting up QA from scratch to improving the QA they already have: test strategy,
            tooling, workflows, audits and automation roadmaps, with AI-driven automation layered on top. Alongside this, I
            mentor QA professionals making the move from manual testing to SDET and leadership roles.
          </p>
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {
            facts.map((f) => (
              <div class="rounded-2xl border border-ink-100 bg-white p-4 text-center dark:border-ink-800 dark:bg-ink-900">
                <dt class="sr-only">{f.label}</dt>
                <dd class="font-display text-3xl font-extrabold text-ink-900 dark:text-white">{f.value}</dd>
                <dd class="mt-1 text-xs font-medium text-ink-500 dark:text-ink-400">{f.label}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary">Work with me</a>
          <a href={site.linkedin} target="_blank" rel="noopener" class="btn-ghost">LinkedIn ↗</a>
          <a href={site.pypi} target="_blank" rel="noopener" class="btn-ghost">PyPI ↗</a>
        </div>
      </div>
    </div>
  </section>

  <CompanyStrip title="Where I've delivered quality" />

  <!-- Impact highlights -->
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Selected work</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Impact highlights</h2>
      <p class="mt-3 max-w-2xl text-ink-600 dark:text-ink-300">A few programs I've led. Client names are withheld; the outcomes are real.</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          highlights.map((h) => (
            <article class="card flex flex-col">
              <span class="chip self-start">{h.domain}</span>
              <h3 class="mt-4 text-xl font-bold">{h.title}</h3>
              <p class="mt-3 flex-1 text-sm text-ink-600 dark:text-ink-300">{h.text}</p>
              <p class="mt-5 flex items-center gap-2 rounded-xl bg-accent-500/10 px-4 py-3 text-sm font-semibold text-accent-800 dark:text-accent-300">
                <Icon d="M4 19h16 M5 15l4-4 3 3 6-7" class="h-4 w-4 shrink-0" />
                {h.result}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Innovation showDeck />

  <Expertise heading="What I bring to the table" />

  <Credentials />

  <!-- Career -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">Career</p>
        <h2 class="mt-3 text-3xl font-extrabold">From QA engineer to test architect</h2>
        <p class="mt-4 text-ink-600 dark:text-ink-300">
          12+ years of steady growth, from hands-on testing to owning QA strategy, architecture and delivery under SAFe Agile.
        </p>
        <div class="mt-8 space-y-6">
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-ink-500 dark:text-ink-400">Awards</h3>
            <ul class="mt-3 space-y-2">
              {awards.map((a) => (
                <li class="flex gap-2 text-sm text-ink-700 dark:text-ink-200">
                  <Icon d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1 3-6z" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600 dark:text-accent-400" />{a}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-ink-500 dark:text-ink-400">Education</h3>
            <ul class="mt-3 space-y-3">
              {education.map((e) => (
                <li>
                  <p class="text-sm font-semibold text-ink-900 dark:text-white">{e.title}</p>
                  <p class="text-xs text-ink-500 dark:text-ink-400">{e.place} · {e.year}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <ol class="relative space-y-4">
        {
          experience.map((e, i) => (
            <li class="card flex gap-4 !p-5">
              <span
                class:list={[
                  'mt-1.5 h-3 w-3 shrink-0 rounded-full',
                  i === 0 ? 'bg-accent-500 ring-4 ring-accent-500/20' : 'bg-ink-300 dark:bg-ink-600',
                ]}
              />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-base font-bold">{e.role}</h3>
                  <span class="text-xs font-semibold text-ink-500 dark:text-ink-400">{e.period}</span>
                </div>
                <p class="text-sm font-medium text-accent-700 dark:text-accent-400">{e.company}</p>
                <ul class="mt-2 space-y-1 text-sm text-ink-600 dark:text-ink-300">
                  {e.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTA title="Let's talk about your quality goals" />
</Base>
