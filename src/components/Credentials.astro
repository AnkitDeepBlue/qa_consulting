---
// Certificate & award gallery with a click-to-enlarge viewer (native <dialog>).
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { credentials } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/credentials/*.jpg', { eager: true });
const imageFor = (name: string) => files[`../assets/credentials/${name}.jpg`]?.default;

const items = await Promise.all(
  credentials
    .filter((c) => imageFor(c.file))
    .map(async (c) => {
      const src = imageFor(c.file)!;
      const full = await getImage({ src, width: 1600, format: 'webp' });
      return { ...c, src, full: full.src };
    }),
);
const groups = [
  { title: 'Awards & recognition', items: items.filter((i) => i.kind === 'award') },
  { title: 'Certifications', items: items.filter((i) => i.kind === 'certification') },
];
---

<section id="credentials" class="section scroll-mt-20">
  <div class="container-x">
    <p class="eyebrow">Verified credentials</p>
    <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Certificates & awards</h2>
    <p class="mt-3 max-w-2xl text-ink-600 dark:text-ink-300">The originals behind the claims. Click any certificate to view it in full.</p>

    {
      groups.map((g) => (
        <div class="mt-10">
          <h3 class="text-sm font-bold uppercase tracking-wider text-ink-500 dark:text-ink-400">{g.title}</h3>
          <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((c) => (
              <li>
                <button
                  type="button"
                  class="credential card group w-full !p-3 text-left hover:-translate-y-0.5 hover:border-accent-300 hover:shadow-md"
                  data-full={c.full}
                  data-title={c.title}
                  data-meta={[c.issuer, c.date].filter(Boolean).join(' · ')}
                >
                  <span class="block overflow-hidden rounded-lg border border-ink-100 bg-white dark:border-ink-800">
                    <Image
                      src={c.src}
                      alt={`${c.title} certificate, ${c.issuer}`}
                      widths={[360, 540]}
                      sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                      class="aspect-[4/3] w-full object-contain transition group-hover:scale-[1.02]"
                    />
                  </span>
                  <span class="mt-3 block px-1 text-sm font-semibold text-ink-900 dark:text-white">{c.title}</span>
                  <span class="block px-1 pb-1 text-xs text-ink-500 dark:text-ink-400">
                    {[c.issuer, c.date].filter(Boolean).join(' · ')}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <dialog id="credential-viewer" class="m-auto w-[min(96vw,1100px)] rounded-2xl bg-white p-0 shadow-2xl backdrop:bg-ink-950/80 dark:bg-ink-900">
    <div class="flex items-start justify-between gap-4 border-b border-ink-100 px-5 py-4 dark:border-ink-800">
      <div>
        <p data-viewer-title class="font-bold text-ink-900 dark:text-white"></p>
        <p data-viewer-meta class="text-sm text-ink-500 dark:text-ink-400"></p>
      </div>
      <button type="button" data-viewer-close class="rounded-md p-2 text-ink-500 hover:bg-ink-50 dark:hover:bg-ink-800" aria-label="Close">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <img data-viewer-img alt="" class="max-h-[78vh] w-full bg-white object-contain" />
  </dialog>
</section>

<script>
  const dialog = document.getElementById('credential-viewer') as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const title = dialog.querySelector('[data-viewer-title]')!;
    const meta = dialog.querySelector('[data-viewer-meta]')!;
    document.querySelectorAll<HTMLButtonElement>('.credential').forEach((btn) =>
      btn.addEventListener('click', () => {
        img.src = btn.dataset.full!;
        img.alt = btn.dataset.title!;
        title.textContent = btn.dataset.title!;
        meta.textContent = btn.dataset.meta!;
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-viewer-close]')?.addEventListener('click', () => dialog.close());
    // Click on the backdrop closes the viewer.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
